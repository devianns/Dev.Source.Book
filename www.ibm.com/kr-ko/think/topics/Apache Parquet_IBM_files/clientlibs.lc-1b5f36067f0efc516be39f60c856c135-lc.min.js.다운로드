window.addEventListener('load', function () {
    setTimeout(initializeDDSTracking, 1000);
});

if (!window.ddsVideoTrackingInitialized) {
    window.ddsVideoTrackingInitialized = false;
}

function initializeDDSTracking() {
    if (window.ddsVideoTrackingInitialized) {
        return;
    }
    window.ddsVideoTrackingInitialized = true;

    var videoPlayersContainers = document.querySelectorAll('c4d-video-player-container-v7');

    if (videoPlayersContainers.length > 0) {
        videoPlayersContainers.forEach(function (videoPlayerContainer) {
            var c4dAnalyticsData =
                videoPlayerContainer.parentElement?.querySelector('#c4d-analytics-data') ||  // for inline video
                videoPlayerContainer.closest('.video-dm')?.querySelector('#c4d-analytics-data') || // for lightbox
                document.querySelector('[cta-type=videoinmodal]')?.nextElementSibling || // for modal video
                null;
            if (!c4dAnalyticsData) {
                return;
            }
            var videoId = videoPlayerContainer.getAttribute('video-id') || // for inline or lightbox
                document.querySelector('[cta-type=videoinmodal]')?.querySelector('c4d-video-player-v7')?.getAttribute('video-id') || // for modal
                "";
            var pageTitle = c4dAnalyticsData.getAttribute('data-title-c4d');
            var lastModified = c4dAnalyticsData.getAttribute('data-last-modified-c4d');
            var videoTags = c4dAnalyticsData.getAttribute('data-tags-c4d') || "";
            var playingMode = c4dAnalyticsData.getAttribute('data-playing-mode-c4d') ||
                "";
            var isoDate = "";
            if (lastModified.includes("UTC")) {
                const date = new Date(lastModified);
                isoDate = date.toISOString();
            } else {
                isoDate = lastModified;
            }

            function getUserAuthStatus() {
                return digitalData.user.segment.isAuthenticated ? "logged in" : "logged out";
            }

            let loginStatus = getUserAuthStatus();
            const currentUrl = document.URL;
            const parts = currentUrl.split("/");
            const sectionOne = parts.length > 3 ? parts[3].split("?")[0] : "";

            function getVideoName() {
                var embeddedVideoPlayer = videoPlayerContainer.querySelector('c4d-video-player-v7');
                return embeddedVideoPlayer ? embeddedVideoPlayer.getAttribute('name') || "" : "";
            }

            function pushVideoEvent(eventType) {
                adobeDataLayer.push({
                    "event": eventType,
                    "_ibm": {
                        "video": {
                            "videoId": videoId,
                            "videoName": getVideoName(),
                            "videoType": "mp4",
                            "videoPublishDate": isoDate,
                            "videoEditDate": isoDate,
                            "videoPlaylistName": "",
                            "videoPlayType": playingMode,
                            "videoTagKeywords": videoTags,
                            [eventType]: {
                                "value": 1
                            }
                        },
                        "user": {
                            "userAgent": navigator.userAgent,
                            "loginStatus": loginStatus
                        }
                    },
                    "web": {
                        "webPageDetails": {
                            "URL": document.URL,
                            "name": pageTitle,
                            "siteSection": sectionOne
                        },
                        "webReferrer": {
                            "URL": document.referrer
                        }
                    }
                });
            }

            function findVideoElement() {
                if (playingMode === "modal") {
                    return document.querySelector(
                        '.video-modal-overlay .playkit-video-player video'
                    ) || null;
                }

                if (playingMode === "lightbox") {
                    return document.querySelector('c4d-lightbox-video-player [data-video-id="' + videoId + '"] .playkit-video-player video') || null;
                }

                return videoPlayerContainer.querySelector('.playkit-video-player video, .playkit-player video, video') || null;
            }

            function trackVideoProgress(video) {
                if (video.hasTracking) return;
                video.hasTracking = true;

                const milestones = {
                    reachedStart: false,
                    reached25: false,
                    reached50: false,
                    reached75: false,
                    completed: false
                };

                video.addEventListener("timeupdate", function () {
                    const percentageWatched = (video.currentTime / video.duration) * 100;

                    if (percentageWatched >= 0.01 && !milestones.reachedStart) {
                        milestones.reachedStart = true;
                        pushVideoEvent("videoStart");
                    }

                    if (percentageWatched >= 25 && !milestones.reached25) {
                        milestones.reached25 = true;
                        pushVideoEvent("video25");
                    }

                    if (percentageWatched >= 50 && !milestones.reached50) {
                        milestones.reached50 = true;
                        pushVideoEvent("video50");
                    }

                    if (percentageWatched >= 75 && !milestones.reached75) {
                        milestones.reached75 = true;
                        pushVideoEvent("video75");
                    }

                    if (percentageWatched >= 100 && !milestones.completed) {
                        milestones.completed = true;
                        video.removeEventListener("timeupdate", arguments.callee);
                        pushVideoEvent("videoComplete");
                    }
                });
            }

            function getObserverRoot() {
                if (playingMode === "modal") {
                    return document.querySelector('.video-modal-overlay') || document.body;
                }

                if (playingMode === "lightbox") {
                    return document.querySelector('c4d-lightbox-video-player') || document.body;
                }

                return videoPlayerContainer;
            }

            function shouldUseObserver() {
                return playingMode === "modal" || playingMode === "lightbox";
            }

            function setupVideoTracking() {
                var video = findVideoElement();
                var observerRoot = getObserverRoot();
                var persistentObserver = shouldUseObserver();

                if (video) { // for inline video dont use observer
                    trackVideoProgress(video);

                    if (!persistentObserver) {
                        return;
                    }
                }

                // use observer for lightbox and modal types
                var observer = new MutationObserver(function () {
                    video = findVideoElement();

                    if (video) {
                        if (!persistentObserver) {
                            observer.disconnect();
                        }

                        trackVideoProgress(video);
                    }
                });

                observer.observe(observerRoot, {
                    childList: true,
                    subtree: true
                });
            }

            setupVideoTracking();
        });
    }
}
