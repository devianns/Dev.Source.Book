.js",settings:{global:!1,source:'function logConsentTable() {\n    const tableData = [\n        { Key: "Functional Is Enabled", Value: _satellite.getVar("Functional Is Enabled") },\n        { Key: "Personalization Is Enabled", Value: _satellite.getVar("Personalization Is Enabled") },\n        { Key: "Functional Is Enabled - Web SDK", Value: _satellite.getVar("Functional Is Enabled - Web SDK") }\n    ];\n\n    let tableString = "### Consent: Adobe Launch Consent Data Elements\\n";\n    tableData.forEach(row => {\n        tableString += `${row.Key}\\t: ${row.Value}\\n`;\n    });\n\n    _satellite.logger.log(tableString);\n}\n\nfunction getConsentPayload(event) {\n    _satellite.logger.log("### Consent: event.type: ", event.$type);\n    var cookieConsentBehavior, privacySettings, cookieNotice;\n    cookieNotice = _satellite.getVar("Consent | trustArcCookiePref") || "";\n    if (event.$type === "core.library-loaded") {\n        cookieConsentBehavior = _satellite.getVar("Local Storage | cookieConsentBehavior");\n        privacySettings = _satellite.getVar("Local Storage | privacySettings");\n    } else if (event.$type === "data-layer-manager-search-discovery.data-layer-push-event") {\n        cookieConsentBehavior = event.detail._ibm.user.cookieConsentBehavior;\n        privacySettings = event.detail._ibm.user.privacySettings;\n    }\n    _satellite.logger.log("### Consent: cookieNotice: ", cookieNotice, " cookieConsentBehavior: ", cookieConsentBehavior, " privacySettings:", privacySettings);\n    return { cookieNotice: cookieNotice, cookieConsentBehavior: cookieConsentBehavior, privacySettings: privacySettings };\n}\n\nfunction checkConsent(event) {\n    const consent = getConsentPayload(event);\n    var personalization = false, functional = false, adobeTrack = "pending";\n\n    if (consent.cookieNotice === "") {\n        if (consent.cookieConsentBehavior == "implied") {\n            adobeTrack = "in";\n            functional = true;\n            personalization = true;